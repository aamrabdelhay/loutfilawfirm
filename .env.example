# --- Database ---
# The sandbox uses a local SQLite database so the site runs without an external
# service. For production (Vercel / Neón / Supabase) switch `provider` in
# prisma/schema.prisma to "postgresql" and set the PostgreSQL URL below.
DATABASE_URL="file:./prisma/dev.db"

# --- Auth ---
# Use a long, random string in production (openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-string-in-production"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin bootstrap (used only by the seed script) ---
ADMIN_EMAIL="admin@loutfilawfirm.net"
ADMIN_PASSWORD="change-me-in-production"
ADMIN_NAME="Administrator"
